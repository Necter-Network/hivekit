{
  "name": "@necter/hivekit",
  "version": "1.0.0",
  "description": "HiveKit JS/TS SDK: build hive-wasm-v1 modules for the Necter network",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Necter-Network/hivekit.git",
    "directory": "hivekit-js"
  },
  "keywords": [
    "hivekit",
    "necter",
    "wasm",
    "assemblyscript",
    "ndsr"
  ],
  "author": "Necter Network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hivec": "dist/cli.js"
  },
  "files": [
    "dist/",
    "runtime/hivekit-js-runtime.wasm",
    "as/",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:runtime": "sh runtime-js/build.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@necter/hivejs": "https://github.com/Necter-Network/hivekit/releases/download/v1.0.0/necter-hivejs-1.0.0.tgz",
    "assemblyscript": "0.28.20",
    "commander": "^12.1.0",
    "js-sha3": "^0.9.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.37.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://necter.network/docs"
}
